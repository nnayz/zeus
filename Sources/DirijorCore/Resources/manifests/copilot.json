{
  "_notice": "Screen-detection predicates adapted from the herdr project (https://github.com/herdrdev/herdr, src/detect/manifests/*.toml), licensed Apache-2.0. Translated from herdr's TOML rule schema into Dirijor's JSON predicate schema and re-prioritised for this engine; the agent capability block is Dirijor's own.",
  "schemaVersion": 2,
  "id": "copilot",
  "version": "2026.07.31.1",
  "statusModel": "full",
  "agent": {
    "displayName": "Copilot CLI",
    "shortLabel": "copilot",
    "glyph": "⊙",
    "aliases": [
      "copilot",
      "github-copilot",
      "ghcs"
    ],
    "firstClass": true,
    "statusAuthority": "screen",
    "binary": "copilot",
    "resume": {
      "style": "latest",
      "token": "--continue"
    },
    "returnToLoginShell": true,
    "foregroundExecNames": [
      "copilot"
    ],
    "_resumeNotice": "Verified against GitHub Docs: 'From the command line, run copilot --continue to resume your most recent session.' https://docs.github.com/en/copilot/how-tos/copilot-cli/use-copilot-cli/chronicle. --resume is the picker/id form, so it cannot provide deterministic latest-session semantics."
  },
  "rules": [
    {
      "id": "blocked-confirm-dialog",
      "state": "blockedPermission",
      "priority": 300,
      "region": "whole_recent",
      "when": {
        "all": [
          {
            "any": [
              {
                "contains": "esc to cancel"
              },
              {
                "contains": "esc cancel"
              }
            ]
          },
          {
            "any": [
              {
                "contains": "enter to select"
              },
              {
                "contains": "enter to confirm"
              },
              {
                "contains": "enter to submit"
              },
              {
                "contains": "enter accept"
              }
            ]
          }
        ]
      },
      "flags": [
        "visible_blocker"
      ],
      "capture": {
        "region": "bottom_non_empty_lines",
        "regionLines": 12,
        "maxChars": 400
      }
    },
    {
      "id": "working-cancel-hint",
      "state": "working",
      "priority": 100,
      "region": "whole_recent",
      "when": {
        "any": [
          {
            "contains": "esc to cancel"
          },
          {
            "contains": "esc cancel"
          },
          {
            "contains": "esc again to cancel"
          },
          {
            "contains": "esc interrupt"
          }
        ]
      }
    }
  ]
}
