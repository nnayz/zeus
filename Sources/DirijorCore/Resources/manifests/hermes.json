{
  "_notice": "Screen-detection predicates adapted from the herdr project (https://github.com/herdrdev/herdr, src/detect/manifests/*.toml), licensed Apache-2.0. Translated from herdr's TOML rule schema into Dirijor's JSON predicate schema and re-prioritised for this engine; the agent capability block is Dirijor's own.",
  "schemaVersion": 2,
  "id": "hermes",
  "version": "2026.07.31.1",
  "statusModel": "full",
  "agent": {
    "displayName": "Hermes",
    "shortLabel": "hermes",
    "glyph": "⌁",
    "aliases": [
      "hermes",
      "hermes-agent"
    ],
    "firstClass": true,
    "statusAuthority": "screen",
    "binary": "hermes",
    "resume": {
      "style": "latest",
      "token": "--continue"
    },
    "returnToLoginShell": true,
    "foregroundExecNames": [
      "hermes"
    ],
    "_resumeNotice": "Verified against Hermes' official session guide: 'hermes --continue' under 'Resume the most recent CLI session'; it says this 'looks up the most recent cli session'. https://github.com/NousResearch/hermes-agent/blob/main/website/docs/user-guide/sessions.md. --resume is the id/title form."
  },
  "rules": [
    {
      "id": "blocked-osc-warning",
      "state": "blockedPermission",
      "priority": 1100,
      "region": "osc_title",
      "when": {
        "regex": "^⚠"
      },
      "flags": [
        "visible_blocker"
      ],
      "capture": {
        "region": "bottom_non_empty_lines",
        "regionLines": 12,
        "maxChars": 400
      }
    },
    {
      "id": "working-osc-hourglass",
      "state": "working",
      "priority": 1050,
      "region": "osc_title",
      "when": {
        "regex": "^⏳"
      }
    },
    {
      "id": "working-interrupt-hint",
      "state": "working",
      "priority": 950,
      "region": "whole_recent",
      "when": {
        "any": [
          {
            "contains": "msg=interrupt"
          },
          {
            "contains": "ctrl+c to interrupt"
          }
        ]
      }
    },
    {
      "id": "blocked-dangerous-command",
      "state": "blockedPermission",
      "priority": 900,
      "region": "whole_recent",
      "when": {
        "all": [
          {
            "any": [
              {
                "contains": "dangerous"
              },
              {
                "contains": "approval"
              }
            ]
          },
          {
            "any": [
              {
                "contains": "allow once"
              },
              {
                "lineRegex": "(?i)^\\s*[▸>]?\\s*1\\.\\s*allow"
              }
            ]
          },
          {
            "any": [
              {
                "contains": "enter confirm"
              },
              {
                "contains": "↑/↓ to select"
              },
              {
                "contains": "show full command"
              }
            ]
          }
        ]
      },
      "flags": [
        "visible_blocker"
      ],
      "capture": {
        "region": "bottom_non_empty_lines",
        "regionLines": 14,
        "maxChars": 400
      }
    },
    {
      "id": "blocked-clarification",
      "state": "blockedQuestion",
      "priority": 890,
      "region": "whole_recent",
      "when": {
        "any": [
          {
            "contains": "hermes needs your"
          },
          {
            "lineRegex": "(?i)^\\s*ask\\s+\\S"
          },
          {
            "contains": "type your answer"
          },
          {
            "contains": "sudo password"
          },
          {
            "contains": "skill setup"
          }
        ]
      },
      "flags": [
        "visible_blocker"
      ],
      "capture": {
        "region": "bottom_non_empty_lines",
        "regionLines": 12,
        "maxChars": 400
      }
    },
    {
      "id": "working-cancel-hint",
      "state": "working",
      "priority": 500,
      "region": "whole_recent",
      "when": {
        "contains": "ctrl+c cancel"
      }
    },
    {
      "id": "idle-osc-check",
      "state": "idle",
      "priority": 100,
      "region": "osc_title",
      "when": {
        "regex": "^✓"
      }
    }
  ]
}
