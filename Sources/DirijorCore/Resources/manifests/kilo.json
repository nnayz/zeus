{
  "_notice": "Screen-detection predicates adapted from the herdr project (https://github.com/herdrdev/herdr, src/detect/manifests/*.toml), licensed Apache-2.0. Translated from herdr's TOML rule schema into Dirijor's JSON predicate schema and re-prioritised for this engine; the agent capability block is Dirijor's own.",
  "schemaVersion": 2,
  "id": "kilo",
  "version": "2026.07.31.1",
  "statusModel": "full",
  "agent": {
    "displayName": "Kilo Code",
    "shortLabel": "kilo",
    "glyph": "◍",
    "aliases": [
      "kilo",
      "kilo-code"
    ],
    "firstClass": true,
    "statusAuthority": "screen",
    "binary": "kilo",
    "resume": {
      "style": "latest",
      "token": "--continue"
    },
    "returnToLoginShell": true,
    "foregroundExecNames": [
      "kilo"
    ],
    "_resumeNotice": "Verified against Kilo's CLI docs: 'Resume your last conversation from the current workspace using the --continue (or -c) flag'. https://kilo.ai/docs/code-with-ai/platforms/cli. --session requires an id."
  },
  "rules": [
    {
      "id": "blocked-permission",
      "state": "blockedPermission",
      "priority": 300,
      "region": "whole_recent",
      "when": {
        "any": [
          {
            "contains": "△ permission required"
          },
          {
            "all": [
              {
                "contains": "esc dismiss"
              },
              {
                "any": [
                  {
                    "contains": "enter confirm"
                  },
                  {
                    "contains": "enter submit"
                  },
                  {
                    "contains": "enter toggle"
                  }
                ]
              },
              {
                "any": [
                  {
                    "contains": "↑↓ select"
                  },
                  {
                    "contains": "⇆ tab"
                  }
                ]
              }
            ]
          }
        ]
      },
      "flags": [
        "visible_blocker"
      ],
      "capture": {
        "region": "bottom_non_empty_lines",
        "regionLines": 12,
        "maxChars": 400
      }
    },
    {
      "id": "working-interrupt",
      "state": "working",
      "priority": 100,
      "region": "whole_recent",
      "when": {
        "any": [
          {
            "contains": "esc interrupt"
          },
          {
            "contains": "esc to interrupt"
          }
        ]
      }
    }
  ]
}
