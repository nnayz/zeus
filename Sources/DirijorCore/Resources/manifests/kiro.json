{
  "_notice": "Screen-detection predicates adapted from the herdr project (https://github.com/herdrdev/herdr, src/detect/manifests/*.toml), licensed Apache-2.0. Translated from herdr's TOML rule schema into Dirijor's JSON predicate schema and re-prioritised for this engine; the agent capability block is Dirijor's own.",
  "schemaVersion": 2,
  "id": "kiro",
  "version": "2026.07.31.1",
  "statusModel": "full",
  "agent": {
    "displayName": "Kiro",
    "shortLabel": "kiro",
    "glyph": "◇",
    "aliases": [
      "kiro",
      "kiro-cli"
    ],
    "firstClass": true,
    "statusAuthority": "screen",
    "binary": "kiro-cli",
    "resume": {
      "style": "latest",
      "token": "--resume"
    },
    "returnToLoginShell": true,
    "foregroundExecNames": [
      "kiro-cli"
    ],
    "_resumeNotice": "Verified against Kiro's CLI reference: '--resume / -r | Resume the previous conversation from this directory'; its example labels 'kiro-cli chat --resume' as 'Resume the most recent chat session'. https://kiro.dev/docs/cli/reference/cli-commands/"
  },
  "rules": [
    {
      "id": "blocked-requires-approval",
      "state": "blockedPermission",
      "priority": 300,
      "region": "whole_recent",
      "when": {
        "all": [
          {
            "contains": "requires approval"
          },
          {
            "any": [
              {
                "contains": "yes, single permission"
              },
              {
                "contains": "trust, always allow"
              },
              {
                "contains": "no (tab to edit)"
              },
              {
                "contains": "esc to close"
              }
            ]
          }
        ]
      },
      "flags": [
        "visible_blocker"
      ],
      "capture": {
        "region": "bottom_non_empty_lines",
        "regionLines": 12,
        "maxChars": 400
      }
    },
    {
      "id": "blocked-subagent-approvals",
      "state": "blockedPermission",
      "priority": 290,
      "region": "whole_recent",
      "when": {
        "all": [
          {
            "contains": "pending from subagents"
          },
          {
            "contains": "tool approval"
          },
          {
            "any": [
              {
                "contains": "approve all pending"
              },
              {
                "contains": "configure individually"
              }
            ]
          }
        ]
      },
      "flags": [
        "visible_blocker"
      ],
      "capture": {
        "region": "bottom_non_empty_lines",
        "regionLines": 12,
        "maxChars": 400
      }
    },
    {
      "id": "working-banner",
      "state": "working",
      "priority": 100,
      "region": "whole_recent",
      "when": {
        "contains": "kiro is working"
      }
    },
    {
      "id": "working-spinner",
      "state": "working",
      "priority": 90,
      "region": "whole_recent",
      "when": {
        "all": [
          {
            "lineRegex": "^\\s*(◔|◑|◕|●)\\s"
          },
          {
            "contains": "esc to cancel"
          }
        ]
      }
    }
  ]
}
