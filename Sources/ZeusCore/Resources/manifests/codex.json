{
  "schemaVersion": 2,
  "id": "codex",
  "version": "2026.07.07",
  "statusModel": "full",
  "agent": {
    "displayName": "Codex",
    "shortLabel": "codex",
    "glyph": "◇",
    "aliases": [
      "codex",
      "openai-codex"
    ],
    "firstClass": true,
    "statusAuthority": "screen",
    "binary": "codex",
    "returnToLoginShell": true,
    "resume": {
      "style": "subcommand",
      "token": "resume"
    },
    "envScrubPrefixes": [
      "CODEX"
    ],
    "injection": {
      "codexNotify": true,
      "codexMCP": true
    },
    "foregroundExecNames": [
      "codex"
    ],
    "approve": {
      "text": "",
      "submit": true
    }
  },
  "rules": [
    {
      "id": "action-required-title",
      "state": "blockedPermission",
      "priority": 1100,
      "region": "osc_title",
      "when": {
        "contains": "action required"
      },
      "flags": [
        "visible_blocker"
      ],
      "capture": {
        "region": "bottom_non_empty_lines",
        "regionLines": 12,
        "maxChars": 400
      }
    },
    {
      "id": "confirm-prompt",
      "state": "blockedPermission",
      "priority": 1000,
      "region": "whole_recent",
      "when": {
        "any": [
          {
            "contains": "press enter to confirm or esc to cancel"
          },
          {
            "contains": "allow command?"
          }
        ]
      },
      "flags": [
        "visible_blocker"
      ],
      "capture": {
        "region": "prompt_box_body",
        "maxChars": 400
      }
    },
    {
      "id": "submit-answer",
      "state": "blockedQuestion",
      "priority": 950,
      "region": "whole_recent",
      "when": {
        "contains": "enter to submit answer"
      },
      "flags": [
        "visible_blocker"
      ],
      "capture": {
        "region": "prompt_box_body",
        "maxChars": 400
      }
    },
    {
      "id": "working-spinner",
      "state": "working",
      "priority": 900,
      "region": "osc_title",
      "when": {
        "regex": "^[⠀-⣿]"
      }
    },
    {
      "id": "idle-prompt-box",
      "state": "idle",
      "priority": 500,
      "region": "prompt_box_body",
      "when": {
        "lineRegex": "^\\s*[❯›]"
      }
    }
  ]
}
