set shell := ["bash", "-uc"]

# List the available recipes.
default:
    @just --list

# Start the local HTTPS development gateway used to test the app.
dev:
    ./scripts/companion-dev.sh

# Build TaskmasterCompanion for the iOS Simulator.
build:
    ./scripts/build.sh

# Build TaskmasterCompanion with the Release configuration.
build-release:
    ./scripts/build.sh --release

# Build and launch TaskmasterCompanion on a simulator (TASKMASTER_IOS_SIMULATOR picks one).
run:
    ./scripts/run.sh

# Open the Xcode project.
xcode:
    open TaskmasterCompanion/TaskmasterCompanion.xcodeproj
